# ── 服务配置 ──
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── 队列配置 ──
QUEUE_TYPE=memory
QUEUE_MAX_SIZE=100
REDIS_URL=redis://localhost:6379

# ── 执行配置 ──
WORKER_CONCURRENCY=3
EXECUTION_TIMEOUT_MS=120000
SYNC_TIMEOUT_MS=60000
BROWSER_HEADLESS=true

REPORT_UPLOAD_TOKEN=123456789abcdefghijklmn123456789

# ── 报告配置 ──
REPORT_DIR=./midscene_run/report
REPORT_MAX_AGE_DAYS=90
PLATFORM_REPORT_UPLOAD_URL=http://localhost:8081/api/platform/internal/reports
PLATFORM_REPORT_PUBLIC_BASE_URL=http://localhost:8081/api/platform/reports/content
PLATFORM_CALLBACK_URL=http://localhost:8081/api/platform/callback/execution-result
REPORT_BASE_URL=http://localhost:3000/reports
REPORT_CLEANUP_CRON=0 2 * * *

# ── Midscene AI 模型配置（通义千问 qwen3-vl） ──
MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MIDSCENE_MODEL_API_KEY=sk-04406a06cced48b29fe7fdca06d121b4
MIDSCENE_MODEL_NAME=qwen3-vl-plus
MIDSCENE_MODEL_FAMILY=qwen3-vl
